 "cells": [
  {
   "cell_type": "markdown",
   "id": "cell-md-00",
   "metadata": {},
   "source": [
    "# Stage 1 — Encoder–Decoder Reconstruction Baseline\n",
    "\n",
    "**Goal**: Validate that a small T5 encoder→decoder can faithfully reconstruct input text\n",
    "from the full encoder hidden state sequence `H ∈ ℝ^{L×d}`.\n",
    "\n",
    "This is the lower-bound reconstruction: the decoder has full access to `H` via cross-attention,\n",
    "no bottleneck is imposed yet. Later notebooks will add the `z_s`/`r` split.\n",
    "\n",
    "**Ablations in this notebook:**\n",
    "1. Zero-noise reconstruction (encoder → decoder, greedy decode)\n",
    "2. Reconstruction after mean-pooling `H` to a single vector `z_pool` (information loss probe)\n",
    "3. Reconstruction after denoising corruption (span masking, token shuffling, case/punct drop)\n"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-imports",
   "metadata": {},
   "outputs": [],
   "source": [
    "# --- dependencies\n",
    "# uv pip install torch transformers datasets evaluate sacrebleu bert-score\n",
    "import torch\n",
    "import torch.nn as nn\n",
    "from transformers import T5ForConditionalGeneration, T5Tokenizer\n",
    "from datasets import load_dataset\n",
    "import evaluate\n",
    "import random, textwrap\n",
    "\n",
    "DEVICE = 'cuda' if torch.cuda.is_available() else 'cpu'\n",
    "MODEL_NAME = 't5-small'  # swap to t5-base once baseline passes\n",
    "MAX_LEN = 128\n",
    "print(f'Device: {DEVICE}')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-model",
   "metadata": {},
   "outputs": [],
   "source": [
    "tokenizer = T5Tokenizer.from_pretrained(MODEL_NAME)\n",
    "model = T5ForConditionalGeneration.from_pretrained(MODEL_NAME).to(DEVICE)\n",
    "\n",
    "def encode(texts: list[str]):\n",
    "    toks = tokenizer(texts, return_tensors='pt', padding=True,\n",
    "                     truncation=True, max_length=MAX_LEN).to(DEVICE)\n",
    "    with torch.no_grad():\n",
    "        enc_out = model.encoder(**toks)\n",
    "    return enc_out.last_hidden_state, toks.attention_mask  # H, mask\n",
    "\n",
    "def decode_from_H(H, mask, max_new=MAX_LEN):\n",
    "    \"\"\"Greedy decode from encoder hidden states.\"\"\""
    "    bsz = H.size(0)\n",
    "    decoder_input = torch.full((bsz, 1),\n",
    "                               tokenizer.pad_token_id, dtype=torch.long, device=DEVICE)\n",
    "    generated = model.generate(\n",
    "        encoder_outputs=type('EO', (), {'last_hidden_state': H})(),\n",
    "        attention_mask=mask,\n",
    "        max_new_tokens=max_new,\n",
    "        decoder_start_token_id=tokenizer.pad_token_id,\n",
    "    )\n",
    "    return tokenizer.batch_decode(generated, skip_special_tokens=True)\n",
    "\n",
    "def decode_from_pool(H, mask, max_new=MAX_LEN):\n",
    "    \"\"\"Mean-pool H to single vector, expand back to sequence, decode.\"\"\""
    "    # NOTE: this is an intentional lossy probe — not a real architecture\n",
    "    z = (H * mask.unsqueeze(-1).float()).sum(1) / mask.sum(1, keepdim=True).float()\n",
    "    H_collapsed = z.unsqueeze(1).expand_as(H)\n",
    "    mask_ones = torch.ones(H.size(0), 1, dtype=torch.long, device=DEVICE)\n",
    "    return decode_from_H(H_collapsed, mask_ones, max_new)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-data",
   "metadata": {},
   "outputs": [],
   "source": [
    "# Load a small sentence corpus for quick iteration\n",
    "ds = load_dataset('sentence-transformers/sentence-compression', split='train[:500]')\n",
    "sentences = [ex['set'][0] for ex in ds if isinstance(ex['set'], list) and len(ex['set']) > 0][:200]\n",
    "print(f'Loaded {len(sentences)} sentences')\n",
    "print('Sample:', sentences[0])"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-corruption",
   "metadata": {},
   "outputs": [],
   "source": [
    "def corrupt_span_mask(text: str, mask_ratio: float = 0.15) -> str:\n",
    "    \"\"\"Replace random word spans with <extra_id_0> sentinels (T5-style denoising).\"\"\""
    "    words = text.split()\n",
    "    n = max(1, int(len(words) * mask_ratio))\n",
    "    idx = sorted(random.sample(range(len(words)), min(n, len(words))))\n",
    "    for i in idx:\n",
    "        words[i] = '<extra_id_0>'\n",
    "    return ' '.join(words)\n",
    "\n",
    "def corrupt_shuffle(text: str, shuffle_ratio: float = 0.2) -> str:\n",
    "    words = text.split()\n",
    "    n = max(1, int(len(words) * shuffle_ratio))\n",
    "    idx = random.sample(range(len(words)), min(n, len(words)))\n",
    "    shuffled = words[:]\n",
    "    vals = [shuffled[i] for i in idx]\n",
    "    random.shuffle(vals)\n",
    "    for i, v in zip(idx, vals):\n",
    "        shuffled[i] = v\n",
    "    return ' '.join(shuffled)\n",
    "\n",
    "def corrupt_case_punct(text: str) -> str:\n",
    "    return text.lower().replace(',', '').replace('.', '').replace('!', '').replace('?', '')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-eval-setup",
   "metadata": {},
   "outputs": [],
   "source": [
    "chrf = evaluate.load('chrf')\n",
    "bertscore = evaluate.load('bertscore')\n",
    "\n",
    "BATCH = 16\n",
    "\n",
    "def run_experiment(src_sentences, name='baseline'):\n",
    "    preds_full, preds_pool = [], []\n",
    "    for i in range(0, len(src_sentences), BATCH):\n",
    "        batch = src_sentences[i:i+BATCH]\n",
    "        H, mask = encode(batch)\n",
    "        preds_full += decode_from_H(H, mask)\n",
    "        preds_pool += decode_from_pool(H, mask)\n",
    "    refs = [[s] for s in src_sentences]\n",
    "    c_full  = chrf.compute(predictions=preds_full,  references=refs)['score']\n",
    "    c_pool  = chrf.compute(predictions=preds_pool,  references=refs)['score']\n",
    "    bs_full = bertscore.compute(predictions=preds_full, references=src_sentences,\n",
    "                                lang='en')['f1']\n",
    "    bs_pool = bertscore.compute(predictions=preds_pool, references=src_sentences,\n",
    "                                lang='en')['f1']\n",
    "    import statistics\n",
    "    print(f'[{name}] full-H  chrF={c_full:.2f}  BERTScore-F1={statistics.mean(bs_full):.4f}')\n",
    "    print(f'[{name}] pool-z  chrF={c_pool:.2f}  BERTScore-F1={statistics.mean(bs_pool):.4f}')\n",
    "    return {'preds_full': preds_full, 'preds_pool': preds_pool}"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-run-baseline",
   "metadata": {},
   "outputs": [],
   "source": [
    "print('=== Ablation 1: Zero-noise reconstruction ===')\n",
    "res_clean = run_experiment(sentences, name='clean')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-run-corruptions",
   "metadata": {},
   "outputs": [],
   "source": [
    "print('=== Ablation 2: Span-masked input → reconstruct original ===')\n",
    "masked_sents = [corrupt_span_mask(s) for s in sentences]\n",
    "res_mask = run_experiment(masked_sents, name='span_mask')\n",
    "\n",
    "print('=== Ablation 3: Shuffled input → reconstruct original ===')\n",
    "shuffled_sents = [corrupt_shuffle(s) for s in sentences]\n",
    "res_shuffle = run_experiment(shuffled_sents, name='shuffle')\n",
    "\n",
    "print('=== Ablation 4: Lowercased/depunctuated → reconstruct original ===')\n",
    "case_sents = [corrupt_case_punct(s) for s in sentences]\n",
    "res_case = run_experiment(case_sents, name='case_punct')"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "id": "cell-inspect",
   "metadata": {},
   "outputs": [],
   "source": [
    "print('=== Qualitative inspection (first 5 examples) ===')\n",
    "for i in range(5):\n",
    "    print(f'\\nOriginal : {sentences[i]}')\n",
    "    print(f'Full-H   : {res_clean[\"preds_full\"][i]}')\n",
    "    print(f'Pool-z   : {res_clean[\"preds_pool\"][i]}')"
   ]
  },
  {
   "cell_type": "markdown",
   "id": "cell-md-next",
   "metadata": {},
   "source": [
    "## Next step\n",
    "\n",
    "The gap between **full-H** and **pool-z** scores quantifies exactly how much information is lost\n",
    "when collapsing `H` to a single vector. This is the *maximum gap* that the residual code `r`\n",
    "in Stage 2 (`02_semantic_residual_split.ipynb`) must recover.\n",
    "\n",
    "**Pass criterion for Stage 1**: full-H chrF ≥ 85 on clean input.\n",
    "If not met, switch to `t5-base` or pre-fine-tune on paraphrase reconstruction before Stage 2."
   ]
  }
 ]
}
